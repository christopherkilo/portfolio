# Public / non-secret configuration examples for local development.
# Copy to `.env.local` and fill in real values there.
# Never commit real secrets. `.env.local` is gitignored.

##################################################
# Application
##################################################
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

##################################################
# TaskFlow (Supabase)
##################################################
# Auth, Postgres/RLS, Realtime, and Storage all use this project.
# Project URL + publishable key are browser-safe when RLS is enabled.
# SUPABASE_SECRET_KEY is server-only — never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

##################################################
# HubSpot CRM (NovaTech)
##################################################
# Private App token + default pipeline/stage for inquiry deals.
# Find pipeline/stage IDs in HubSpot → Settings → Objects → Deals → Pipelines
# (or via the CRM pipelines API).
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=

##################################################
# Resend (NovaTech email)
##################################################
# From address must be allowed for your Resend account/domain.
RESEND_API_KEY=
NOVATECH_FROM_EMAIL=
NOVATECH_STAFF_EMAIL=

##################################################
# Cloudflare Turnstile (NovaTech)
##################################################
# Site key is public (widget); secret key stays server-side in `.env.local` only.
# Local testing: use Cloudflare test keys, or set
# NOVATECH_ALLOW_TURNSTILE_DEV_BYPASS=true and submit with the UI mock token.
# Never enable the bypass in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NOVATECH_ALLOW_TURNSTILE_DEV_BYPASS=

##################################################
# PostgreSQL (Event Horizon backend)
##################################################
# Use a pooled URL for the app if your host provides one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/event_horizon?schema=public
# Optional direct (non-pooled) URL for migrations
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/event_horizon?schema=public
# Optional isolated DB for destructive integration tests only
TEST_DATABASE_URL=

##################################################
# Auth.js (Event Horizon) — https://authjs.dev
##################################################
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional: AUTH_URL is inferred from NEXT_PUBLIC_APP_URL in many setups
AUTH_URL=http://localhost:3000

# Google OAuth (primary) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth.js also accepts these aliases:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (optional) — https://github.com/settings/developers
# Only registered when BOTH values are non-empty.
# Authorization callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

##################################################
# Optional follow-on integrations
##################################################
# TaskFlow already uses the Supabase project above for realtime, storage,
# and authenticated collaboration. Additional providers (standalone email
# or push) can be added later without changing the current demo contract.
# TASKFLOW_FROM_EMAIL=
