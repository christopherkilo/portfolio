// Prisma schema for Event Horizon (PostgreSQL)
// Auth.js models follow @auth/prisma-adapter requirements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  reservations  Reservation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Event Horizon domain
// ---------------------------------------------------------------------------

enum EventCategory {
  Music
  Tech
  Arts
  Food
  Sports
  Nightlife
}

enum EventStatus {
  upcoming
  sold_out
  cancelled
  postponed
}

enum TicketAvailability {
  available
  limited
  sold_out
}

enum ReservationStatus {
  /// Demo pre-payment confirmation (no Stripe yet).
  confirmed
  cancelled
}

model Event {
  id               String        @id
  slug             String        @unique
  title            String
  shortDescription String
  description      String        @db.Text
  category         EventCategory
  venue            String
  city             String
  state            String
  country          String
  address          String
  timezone         String
  startDateTime    DateTime
  endDateTime      DateTime
  image            String
  gallery          String[]
  featured         Boolean       @default(false)
  tags             String[]
  capacity         Int
  status           EventStatus   @default(upcoming)
  organizer        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ticketTypes   TicketType[]
  favorites     Favorite[]
  reservations  Reservation[]

  @@index([category])
  @@index([city])
  @@index([featured])
  @@index([status])
  @@index([startDateTime])
}

model TicketType {
  id                String             @id
  eventId           String
  name              String
  description       String
  priceInCents      Int
  currency          String             @default("USD")
  quantityRemaining Int
  purchaseLimit     Int
  availability      TicketAvailability @default(available)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reservations  Reservation[]

  @@index([eventId])
  @@index([availability])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Reservation {
  id                 String            @id @default(cuid())
  confirmationNumber String            @unique
  idempotencyKey     String            @unique
  userId             String
  eventId            String
  ticketTypeId       String
  quantity           Int
  unitPriceInCents   Int
  subtotalInCents    Int
  feeInCents         Int
  totalInCents       Int
  currency           String            @default("USD")
  status             ReservationStatus @default(confirmed)
  reservedAt         DateTime          @default(now())
  cancelledAt        DateTime?

  /// Historical display snapshots (survive catalog edits).
  eventTitleSnapshot     String
  eventImageSnapshot     String
  venueSnapshot          String
  eventDateSnapshot      DateTime
  ticketTypeNameSnapshot String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@index([status])
  @@index([reservedAt])
}
